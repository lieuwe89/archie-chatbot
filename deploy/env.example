# --- archie-chatbot VPS env (copy to /srv/apps/archie-chatbot/.env, mode 600) ---

# Backend server port (must match docker-compose internal-port mapping).
PORT=4008
NODE_ENV=production

# Data dir on the mounted volume.
DATA_DIR=/data

# LLM provider: gemini | claude | openrouter
LLM_PROVIDER=gemini

# Provider API keys (only the active provider's key is required).
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=

# Search tools.
TAVILY_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Admin (knowledge-base panel at /admin and auto-seeded API user).
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me
ARCHIE_ADMIN_PASSWORD=change-me

# Session signing. Generate with: openssl rand -hex 32
ARCHIE_SESSION_SECRET=change-me

# JWT signing for API auth.
JWT_SECRET=change-me

# REDIS_URL intentionally omitted — sessionStoreFactory falls back to
# SQLiteSessionStore (writes to /data/sessions.db) when unset.
