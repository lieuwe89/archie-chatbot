# Backend server port
PORT=4008

# Node environment
NODE_ENV=development

# Gemini API Key (required)
GEMINI_API_KEY=your-gemini-api-key

# Tavily Search API Key (required for web search tools)
TAVILY_API_KEY=your-tavily-api-key

# Admin password for /archie/admin panel (required)
ARCHIE_ADMIN_PASSWORD=your-secure-password

# Session secret for express-session (optional, defaults to 'archie-dev-secret')
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARCHIE_SESSION_SECRET=your-session-secret

# Data directory (optional, defaults to ./server/database in dev, /data in prod)
# DATA_DIR=./server/database

# Redis URL for distributed sessions (optional)
# If not set, falls back to SQLite session store
# Examples:
#   redis://localhost:6379
#   redis://username:password@redis-server:6379
#   redis://:password@redis-server:6379/1
# REDIS_URL=redis://localhost:6379

# Optional: Admin username (used with ARCHIE_ADMIN_PASSWORD for auto-setup)
# ADMIN_USERNAME=admin@example.com